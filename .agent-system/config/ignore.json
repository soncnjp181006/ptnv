{
  "version": "0.2.0",
  "description": "Tệp cấu hình loại trừ thư mục và tệp dùng chung cho toàn bộ agindex framework và MCP servers",
  "ignore_hidden_directories": true,
  "default_framework_dirs": [
    "node_modules",
    "venv",
    ".venv",
    "env",
    ".env",
    "__pycache__",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    ".tox",
    "eggs",
    "*.egg-info",
    "dist",
    "build",
    "out",
    "target",
    "bin",
    "obj",
    ".gradle",
    "gradle",
    "vendor",
    ".bundle",
    ".dart_tool",
    ".next",
    ".nuxt",
    ".turbo",
    ".svelte-kit",
    ".cache",
    "coverage",
    ".agent-system",
    ".git",
    ".svn",
    ".hg",
    ".idea",
    ".vscode"
  ],
  "user_exclude_dirs": [
  ],
  "default_file_patterns": [
    "*.min.js",
    "*.min.css",
    "*.bundle.js",
    "*.map",
    "*.lock",
    "package-lock.json",
    "yarn.lock",
    "pnpm-lock.yaml",
    "Cargo.lock",
    "poetry.lock",
    "composer.lock",
    "*.log",
    "*.tmp",
    "*.bak",
    "*.swp",
    "*.pyc",
    "*.pyo",
    "*.class",
    "*.dll",
    "*.exe",
    "*.so",
    "*.dylib"
  ],
  "user_exclude_files": [
  ],
  "max_file_size_kb": 1024,
  "ignore_hidden_files": true
}
